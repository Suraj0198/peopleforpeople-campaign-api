# Copy to .env for local use, or set these on Render.
APP_ENV=development

# Local: SQLite file. Staging/production: the same Neon URL the auth service uses.
DATABASE_URL=sqlite:///./campaigns.db
# DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/neondb?sslmode=require

# dev    = local testing with the X-Dev-User header (blocked in production)
# db     = check the auth service's sid cookie in the shared database (recommended on Render)
# remote = ask the auth service's /auth/me
AUTH_MODE=dev
AUTH_BASE_URL=https://auth-backend-lb6o.onrender.com
SESSION_COOKIE=sid

CORS_ORIGINS=http://localhost:5173
AUTO_CREATE_TABLES=true
